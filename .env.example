# Copy this file to .env and fill in the keys. The app reads ONLY .env, never this file.
# Never put real keys in this file: it is a shared template. .env is git-ignored.
#
# Lines starting with # are optional. Their defaults live in app/config.py.
# A value set in .env wins over config.py, so change each setting in ONE place: .env.

GROQ_API_KEY=
TAVILY_API_KEY=
PINECONE_API_KEY=

# Key for the staff tools (upload a document, see recent questions). Leave empty to switch them off.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Supabase: accounts and saved chats (Project Settings > API in the Supabase dashboard). The chat needs them: with these empty,
# the chat page says "Accounts are not set up". Steps are in supabase/README.md.
# The publishable key is safe in a browser. The secret key skips the database's safety rules: the running app never uses it.
# Only `python -m app.supabase.check --full` reads it, to make and delete throwaway test users.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Optional (the defaults are shown). Ingest and chat must use the same index and namespace.
# PINECONE_INDEX_NAME=fde-it-support-rag
# PINECONE_NAMESPACE=company-it-kb
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# TOP_K=4
# MAX_RETRIES=1
# MEMORY_TURNS=3
